# ASP.NET
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
PROCESSOR_PORT=8080
CDK_MINT_PORT=3338

# Postgres
PROCESSOR_DB=cdk_arkade_processor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Processor wallet — REQUIRED: set a real mnemonic, never reuse regtest keys
PROCESSOR_WALLET_ID=arkade-mint
PROCESSOR_WALLET_SECRET=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12
PROCESSOR_UNIT=sat

# CDK mintd — REQUIRED: set a real mnemonic
CDK_MINTD_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12
CDK_MINTD_MINT_NAME=My Arkade Mutinynet Mint
CDK_MINTD_MINT_DESCRIPTION=Cashu mint backed by Arkade on mutinynet

# Mutinynet Arkade endpoints (defaults are already set in compose.mutinynet.yaml)
# ARK_URI=https://mutinynet.arkade.sh
# ARKADE_WALLET_URI=https://mutinynet.arkade.money
# BOLTZ_URI=https://api.boltz.mutinynet.arkade.sh/
# EXPLORER_URI=https://explorer.mutinynet.arkade.sh

# NBXplorer is not used on mutinynet — the app uses Esplora via ExplorerUri above
