# ASP.NET
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
PROCESSOR_PORT=8080
CDK_MINT_PORT=3338

# Postgres
PROCESSOR_DB=cdk_arkade_processor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Processor wallet
PROCESSOR_WALLET_ID=arkade-mint
PROCESSOR_WALLET_SECRET=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about
PROCESSOR_UNIT=sat

# Ark/NBXplorer network endpoints
# Compose defaults point to nigiri container names (correct for CI and same-network compose stacks).
# Override below when nigiri runs separately from this compose (e.g. local dev with nigiri on host).
# ARK_URI=http://host.docker.internal:7070
# ARKADE_WALLET_URI=http://host.docker.internal:3002
# BOLTZ_URI=http://host.docker.internal:9069/
# EXPLORER_URI=http://host.docker.internal:3000
# NBXPLORER_URI=http://host.docker.internal:24444/
NBXPLORER_NETWORK=Regtest
